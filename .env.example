# Copy to .env and fill in. Real environment variables take precedence.

# --- Telegram (REQUIRED — primary alert + error channel) --------------------
# 1. Talk to @BotFather -> /newbot -> copy the token.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- What reaches your phone ------------------------------------------------
# launches (default) = only actual token launches on the launchpad, plus
#                      watcher-health messages so a broken watcher is visible.
# all                = also team wallet txs, factory deploys, frontend diffs.
# Detection is identical either way; this filters delivery only. Recon
# signals are still written to the log.
#ALERTS_MODE=launches

# Ticker collisions are severe: six CLOCKIN variants already exist on the
# StonkBrokers factory (supplies 1e6 to 1e9) plus a squat on pools.fun. Set
# the real token's total supply and a name match is graded CONFIRMED vs
# CANDIDATE - SPEC MISMATCH instead of being trusted on the ticker alone.
# Per-symbol, e.g. EXPECTED_SUPPLIES=CLOCKIN:1000000000,FOO:99
# YARD=1999999980 is built in. Symbols with no entry stay CANDIDATE.
#EXPECTED_SUPPLIES=
# Fallback for symbols with no entry above.
#EXPECTED_SUPPLY=

# up. DEX (up33.xyz): launcher graduates are expected to get LP/gauges there
# after bonding. No dedicated module - the addresses are unpublished and it
# is a graduation signal, not a launch one. Once you have the factory or
# voter address, put it in WATCH_CONTRACTS above and it is armed next cycle.

# --- Launch timing ----------------------------------------------------------
# T0 = Stonk Launcher go-live. Default is 2026-08-12T00:00:00Z
# (Tue Aug 11, 8:00 PM EST). Override only for testing, e.g. now+2min.
#T0_UTC=2026-08-12T00:00:00Z

# --- Robinhood Chain --------------------------------------------------------
# Robinhood Chain mainnet is chain ID 4663. The official public RPC below is
# the recommended value; it's shared and rate limited, so a dedicated
# provider endpoint (QuickNode/Alchemy/Chainstack) is better if you have one.
# Leave blank to fall back to the Blockscout JSON-RPC proxy.
#RPC_URL=https://rpc.mainnet.chain.robinhood.com
#BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com

# OPTIONAL — leave blank unless you know the address.
# Enables LP/market-event alerts on tokens already being tracked. It does NOT
# affect capturing the CLOCKIN CA, so a wrong value is worse than an empty
# one. To find it: open a token that launched on the Stonk AMM in Blockscout,
# find the tx that created its market, and take the contract that emitted the
# event. Track 3 (frontend diffing) also surfaces launcher infra addresses.
#AMM_FACTORY_ADDRESS=
#AMM_FACTORY_START_BLOCK=29738000

# Extra team wallets beyond the two built-in ones (comma-separated).
#EXTRA_TEAM_WALLETS=

# Contracts to watch topic-agnostically. Add the launcher factory here the
# moment you learn its address — picked up on the next cycle, no restart.
#WATCH_CONTRACTS=0x...

# --- Optional channels ------------------------------------------------------
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=+1...
#TWILIO_TO=+1...
#MACOS_ALERTS=1

# --- Error reporting / heartbeat -------------------------------------------
# Repeat identical errors are re-alerted at most once per this many seconds.
#ERROR_ALERT_COOLDOWN=600
# Consecutive failures before a "channel down" alert fires.
#FAILURE_ALERT_THRESHOLD=5
# Telegram "WATCHER ALIVE" heartbeat every N hours (0 = off).
#HEARTBEAT_HOURS=6
