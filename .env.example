# Scanner Settings
SCAN_INTERVAL_SECONDS=120
MAX_MARKET_CAP=50000000
MIN_DCA_VALUE_USD=500
DCA_CLUSTER_WINDOW_HOURS=24
DCA_CLUSTER_MIN_ORDERS=3
ALERT_COOLDOWN_HOURS=4
