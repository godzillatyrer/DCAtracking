# --- required (unless DRY_RUN=true) ---------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# --- tuning ---------------------------------------------------------------
# Which tiers to alert on. Valid values: free, gold, diamond
WATCH_TIERS=gold,diamond

# How often to poll, in ms. 30s is polite and fast enough. Min 5000.
POLL_INTERVAL_MS=30000

# Where to remember what has already been alerted. Use an absolute path if you
# run under systemd, because the working directory may not be what you expect.
STATE_FILE=./state.json

# --- optional -------------------------------------------------------------
# Print the alert to stdout instead of sending it. No token needed.
# DRY_RUN=true

# Do a single pass and exit (useful for cron).
# RUN_ONCE=true

# By default the very first run records existing Gold/Diamond coins silently so
# you don't get a flood of history. Set this to alert on them anyway.
# ALERT_ON_FIRST_RUN=true

# VERBOSE=true
