# --- required (unless DRY_RUN=true) ---------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# --- tuning ---------------------------------------------------------------
# Which tiers to alert on. Valid values: free, gold, diamond
WATCH_TIERS=gold,diamond

# How often to poll, in ms. 30s is polite and fast enough. Min 5000.
POLL_INTERVAL_MS=30000

# Where to remember what has already been alerted. Use an absolute path if you
# run under systemd, because the working directory may not be what you expect.
STATE_FILE=./state.json

# --- optional -------------------------------------------------------------
# Print the alert to stdout instead of sending it. No token needed.
# DRY_RUN=true

# Do a single pass and exit (useful for cron).
# RUN_ONCE=true

# By default the very first run records existing Gold/Diamond coins silently so
# you don't get a flood of history. Set this to alert on them anyway.
# ALERT_ON_FIRST_RUN=true

# VERBOSE=true

# Alert when a team pays the "Get Listed" fee to list an existing token. Detected
# structurally: a listed coin has no bonding curve, a launchpad coin does.
# Fires on any tier. Currently matches nothing — listings are paused.
# WATCH_LISTINGS=false

# Tell me if the feed ever returns a tier/status value we have never seen. This
# is the backstop for the filter above, since no real paid listing has been
# observed yet and its shape is a well-reasoned guess.
# SCHEMA_DRIFT_ALERT=false

# Alert if no fetch has succeeded in this long. The feed only holds ~50 minutes
# of history, so a longer outage silently loses coins. Default 10 minutes.
# STALE_ALERT_MS=600000

# Periodic "still alive" message, so silence is distinguishable from breakage.
# Default 24h. Set to 0 to disable.
# HEARTBEAT_MS=86400000

# Alert on $ANSEM burns, read from /api/leaderboard/burners. Burning is how a
# team pays the listing fee and climbs the tier ladder, so it is the earliest
# warning that a listing is coming.
# WATCH_BURNS=false

# Ignore burns below this USD value. A burn that crosses a tier threshold is
# always reported regardless. If the price is unavailable the burn is reported
# without a USD figure rather than treated as $0.
# BURN_MIN_USD=1000

# Alert when /api/listing/config flips to enabled (listings reopen) or the
# site-wide gate in /api/gate changes.
# WATCH_STATUS=false

# How often to poll those two, in ticks. They change rarely and the origin is
# behind Cloudflare, so every tick would be wasteful. Default 10 (~5 min).
# STATUS_POLL_EVERY=10
