# Database
DATABASE_URL=postgresql://scanner:password@host:5432/pump_scanner

# Telegram (create via @BotFather, then /start your bot in the target chat)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_or_channel_id

# Helius (Solana RPC — free tier at helius.dev)
HELIUS_API_KEY=your_helius_api_key

# GMGN (Solana smart money — free tier at gmgn.ai, key optional)
GMGN_API_KEY=

# Birdeye (Solana token metadata — free tier at birdeye.so)
BIRDEYE_API_KEY=your_birdeye_api_key

# Etherscan + BscScan (free at etherscan.io/apis, bscscan.com/apis) —
# used for ETH + BSC fresh/dormant wallet classification. Watcher logs
# and skips if these are unset.
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# DeFi Llama + GeckoTerminal + DEX Screener need NO keys — public APIs
