# Copy to .env and fill in. Real environment variables take precedence.

# --- Telegram (REQUIRED — primary alert + error channel) --------------------
# 1. Talk to @BotFather -> /newbot -> copy the token.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Launch timing ----------------------------------------------------------
# T0 = Stonk Launcher go-live. Default is 2026-08-12T00:00:00Z
# (Tue Aug 11, 8:00 PM EST). Override only for testing, e.g. now+2min.
#T0_UTC=2026-08-12T00:00:00Z

# --- Robinhood Chain --------------------------------------------------------
# Defaults to the Blockscout JSON-RPC proxy. Point at a real node if you have
# one (lower latency, higher getLogs limits).
#RPC_URL=https://robinhoodchain.blockscout.com/api/eth-rpc
#BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com

# Optional: known AMM factory (AMMFactoryV2) for LP/market detection on
# tracked tokens, and its earliest interesting block.
#AMM_FACTORY_ADDRESS=
#AMM_FACTORY_START_BLOCK=29738000

# Extra team wallets beyond the two built-in ones (comma-separated).
#EXTRA_TEAM_WALLETS=

# --- Optional channels ------------------------------------------------------
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=+1...
#TWILIO_TO=+1...
#MACOS_ALERTS=1

# --- Error reporting / heartbeat -------------------------------------------
# Repeat identical errors are re-alerted at most once per this many seconds.
#ERROR_ALERT_COOLDOWN=600
# Consecutive failures before a "channel down" alert fires.
#FAILURE_ALERT_THRESHOLD=5
# Telegram "WATCHER ALIVE" heartbeat every N hours (0 = off).
#HEARTBEAT_HOURS=6
