{
  "name": "ansem-tier-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram alerts when a coin lands in the Gold or Diamond tier on ansem.io",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node watch.mjs",
    "once": "RUN_ONCE=true node watch.mjs",
    "dry": "DRY_RUN=true RUN_ONCE=true VERBOSE=true node watch.mjs",
    "test": "bash test/run-tests.sh"
  }
}
